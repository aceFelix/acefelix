# 知识抽取（GraphRAG）模型配置示例
# 复制为 backend/ingest.toml 后按需修改；ingest.toml 含密钥已被 .gitignore 排除。
# 配置优先级：环境变量（INGEST_*）> 本文件 > 内置默认值。
# api_key 留空时自动回退环境变量 DASHSCOPE_API_KEY / OPENAI_API_KEY。

# @author aceFelix

[ingest]
# OpenAI 兼容端点（默认 DashScope 兼容模式）
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# 抽取模型（建议独立便宜模型，与主 LLM 解耦）
model = "qwen-flash"
# API Key（建议留空，避免明文入库）
api_key = ""
# api_key 留空时从哪个环境变量读取（如 DEEPSEEK_API_KEY / KIMI_API_KEY）；
# 再留空则依次回退 DASHSCOPE_API_KEY / OPENAI_API_KEY
api_key_env = ""
# 抽取温度（低温度保证结构化输出稳定）
temperature = 0.1
# 单次调用超时（秒）
timeout = 60
# 送入 LLM 的文本上限（超长截断，控制 token 成本）
max_chars = 8000
